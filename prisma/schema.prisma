generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  saved
  applied
  interview
  offer
  rejected
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  applications Application[]
  gmailAccount GmailAccount?

  @@map("users")
}

// Отдельная таблица под refresh_token — не смешиваем её с User,
// т.к. это чувствительные данные со своим жизненным циклом (revoke, refresh)
model GmailAccount {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  refreshToken String   @map("refresh_token")
  scope        String
  connectedAt  DateTime @default(now()) @map("connected_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_accounts")
}

model Application {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  company     String
  role        String
  status      ApplicationStatus @default(saved)
  appliedDate DateTime          @map("applied_date") @db.Date
  url         String?
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([userId])
  @@map("applications")
}

model Response {
  id             String    @id @default(uuid())
  applicationId  String    @map("application_id")
  gmailMessageId String?   @map("gmail_message_id")
  sender         String?
  subject        String?
  receivedAt     DateTime? @map("received_at")
  content        String?
  createdAt      DateTime  @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("responses")
}
